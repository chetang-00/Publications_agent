# Copy to .env and fill in PORTKEY_API_KEY. Never commit .env.

# ── Portkey gateway (OpenAI-compatible) ─────────────────────────────────────
PORTKEY_BASE_URL=https://ai-gateway.apps.cloud.rt.nyu.edu/v1
PORTKEY_API_KEY=
# Only if your gateway routes by virtual key; leave blank when models are named "@provider/model".
PORTKEY_VIRTUAL_KEY=
# Optional separate credentials for embeddings (default to the values above).
EMBEDDING_PORTKEY_API_KEY=
EMBEDDING_PORTKEY_VIRTUAL_KEY=

# ── Models ──────────────────────────────────────────────────────────────────
CHAT_MODEL=@gpt-4o-mini/gpt-4o-mini
EMBEDDING_MODEL=@openai-embedding/text-embedding-3-small
EMBEDDING_BATCH_SIZE=256
# Set to false if the gateway rejects stream_options (token usage is then not recorded).
LLM_STREAM_USAGE=true
# Sampling temperature; leave blank for reasoning models (o-series), which reject it.
LLM_TEMPERATURE=0.2

# ── Agent ───────────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=8
TOOL_TIMEOUT_SECONDS=20

# ── Uploads and logging ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# ── Web UI port (bound to 127.0.0.1 only) ───────────────────────────────────
WEB_PORT=8080

# ── Local development outside Docker only (docker compose sets these itself) ─
# DATABASE_URL=sqlite+aiosqlite:///../data/dev/app.db
# QDRANT_URL=http://localhost:6333
# UPLOAD_DIR=../data/dev/uploads
# CORS_ORIGINS=http://localhost:5173
